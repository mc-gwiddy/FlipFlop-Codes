Next x

ts = 1
t(ts, 1) = 1

Do Until te = ilen
tname = t(ts, 0)
cp = ts
found = False
        Do Until found = True
            If cp + 1 > ilen Then
            cp = 1
            Else
            cp = cp + 1
            End If
            If t(cp, 0) = tname Then
            te = cp
            t(te, 1) = 1
            d = Abs(te - ts)
                If tname = UCase(tname) Then
                d3 = d * -1
                Else
                d3 = d
                End If
            Exit Do
            End If
        Loop
td = td + d
td3 = td3 + d3
If cp + 1 > ilen Then
ts = 1
Else
ts = cp + 1
End If
t(ts, 1) = 1
Loop

ansp1 = td
Debug.Print ansp1
