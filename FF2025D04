Part 1 Formula:
=LET(rng,A.:.A,
x,--TEXTBEFORE(rng,","),
y,--TEXTAFTER(rng,","),
prevc,VSTACK("0,0",INDEX(rng,SEQUENCE(ROWS(rng)-1))),
prevx,--TEXTBEFORE(prevc,","),
prevy,--TEXTAFTER(prevc,","),
dist,ABS(x-prevx)+ABS(y-prevy),
ans,SUM(dist),
ans)

